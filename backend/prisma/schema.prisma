generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model Institution {
  id                             String                          @id @default(uuid()) @db.VarChar(36)
  name                           String                          @db.VarChar(255)
  code                           String                          @unique @db.VarChar(50)
  institutionType                InstitutionType                 @default(SCHOOL) @map("institution_type")
  address                        String?                         @db.Text
  contactEmail                   String?                         @map("contact_email") @db.VarChar(255)
  contactPhone                   String?                         @map("contact_phone") @db.VarChar(20)
  academicYear                   String                          @default("2025-2026") @map("academic_year") @db.VarChar(20)
  logoUrl                        String?                         @map("logo_url") @db.VarChar(500)
  darkLogoUrl                    String?                         @map("dark_logo_url") @db.VarChar(500)
  signatureUrl                   String?                         @map("signature_url") @db.VarChar(500)
  signatureTitle                 String                          @default("Principal") @map("signature_title") @db.VarChar(100)
  sealUrl                        String?                         @map("seal_url") @db.VarChar(500)
  enabledFields                  Json                            @map("enabled_fields")
  customFields                   Json                            @map("custom_fields")
  enabledServices                Json                            @map("enabled_services")
  subscriptionTier               SubscriptionTier                @default(starter) @map("subscription_tier")
  subscriptionStatus             SubscriptionStatus              @default(trial) @map("subscription_status")
  trialEndsAt                    DateTime?                       @map("trial_ends_at")
  subscriptionStart              DateTime?                       @map("subscription_start")
  subscriptionEnd                DateTime?                       @map("subscription_end")
  monthlyAiUsage                 Int                             @default(0) @map("monthly_ai_usage")
  monthlyPdfPages                Int                             @default(0) @map("monthly_pdf_pages")
  monthlyEmailSent               Int                             @default(0) @map("monthly_email_sent")
  storageUsedMb                  Decimal                         @default(0.00) @map("storage_used_mb") @db.Decimal(10, 2)
  isActive                       Boolean                         @default(true) @map("is_active")
  onboardingCompleted            Boolean                         @default(false) @map("onboarding_completed")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  whatsappPhoneNumberId          String?                         @map("whatsapp_phone_number_id") @db.VarChar(50)
  whatsappWabaId                 String?                         @map("whatsapp_waba_id") @db.VarChar(50)
  razorpayAccountId              String?                         @map("razorpay_account_id") @db.VarChar(100)
  monthlyWhatsappSent            Int                             @default(0) @map("monthly_whatsapp_sent")
  featureOverrides               Json?                           @map("feature_overrides")
  moduleConfig                   Json?                           @map("module_config")
  adminInvitations               AdminInvitation[]
  alumni                         Alumni[]
  alumniEvents                   AlumniEvent[]
  approvalRequests               ApprovalRequest[]
  approvalWorkflows              ApprovalWorkflow[]
  approvals                      Approval[]
  assignmentSubmissions          AssignmentSubmission[]
  assignments                    Assignment[]
  attendanceLogs                 AttendanceLog[]
  attendanceSessions             AttendanceSession[]
  auditLogs                      AuditLog[]
  biometricDevices               BiometricDevice[]
  biometricPunches               BiometricPunch[]
  branches                       Branch[]
  calculationEngines             CalculationEngine[]
  calendarEvents                 CalendarEvent[]
  cceAssessments                 CceAssessment[]
  cceMarks                       CceMark[]
  certificates                   Certificate[]
  classes                        Class[]
  clinicVisits                   ClinicVisit[]
  conversationMessages           ConversationMessage[]
  conversations                  Conversation[]
  curriculumScopes               InstitutionCurriculumScope[]
  digestQueue                    DigestQueue[]
  enquiries                      Enquiry[]
  enquiryActivities              EnquiryActivity[]
  examSchedules                  ExamSchedule[]
  feeConcessions                 FeeConcession[]
  feeInstallmentPlans            FeeInstallmentPlan[]
  feeInstallments                FeeInstallment[]
  feeInvoices                    FeeInvoice[]
  feePaymentClaims               FeePaymentClaim[]
  feePayments                    FeePayment[]
  feeStructures                  FeeStructure[]
  gatePasses                     GatePass[]
  groupPhotos                    GroupPhoto[]
  guardianStudentLinks           GuardianStudentLink[]
  guardians                      Guardian[]
  hallTickets                    HallTicket[]
  healthRecords                  HealthRecord[]
  hostelAllotments               HostelAllotment[]
  hostelBlocks                   HostelBlock[]
  hostelRooms                    HostelRoom[]
  idCardBatches                  IdCardBatch[]
  idCards                        IdCard[]
  inboundMedia                   InboundMedia[]
  authorities                    InstitutionAuthority[]
  inventoryCategories            InventoryCategory[]
  inventoryItems                 InventoryItem[]
  jobExecutions                  JobExecution[]
  journalEntries                 JournalEntry[]
  ledgerAccounts                 LedgerAccount[]
  libraryCards                   LibraryCard[]
  liveClasses                    LiveClass[]
  marksheets                     Marksheet[]
  messBills                      MessBill[]
  messageTemplates               MessageTemplate[]
  messages                       Message[]
  notices                        Notice[]
  notificationLogs               NotificationLog[]
  notificationTemplates          NotificationTemplate[]
  notifications                  Notification[]
  onlineTestAttempts             OnlineTestAttempt[]
  onlineTests                    OnlineTest[]
  outbox                         Outbox[]
  placementApplications          PlacementApplication[]
  placementDrives                PlacementDrive[]
  portfolios                     Portfolio[]
  questionBankItems              QuestionBankItem[]
  savedReports                   SavedReport[]
  sections                       Section[]
  socialPosts                    SocialPost[]
  socialRelationships            SocialRelationship[]
  staffAttendances               StaffAttendance[]
  staffMembers                   StaffMember[]
  stockTransactions              StockTransaction[]
  streams                        Stream[]
  StudentFormProgress            StudentFormProgress[]
  StudentOnboardingToken         StudentOnboardingToken[]
  students                       Student[]
  subjects                       Subject[]
  templates                      Template[]
  timetablePeriods               TimetablePeriod[]
  transferCertificates           TransferCertificate[]
  transportRoutes                TransportRoute[]
  userRoles                      UserInstitutionRole[]
  vaccinationRecords             VaccinationRecord[]
  visionariumArticles            VisionariumArticle[]
  visionariumSchoolSubscriptions VisionariumSchoolSubscription[]
  visionariumSubmissions         VisionariumSubmission[]
  visionariumTestSeries          VisionariumTestSeries[]
  visitingCards                  VisitingCard[]
  visitorLogs                    VisitorLog[]

  @@index([code])
  @@index([subscriptionStatus, subscriptionTier])
  @@index([isActive])
  @@map("institutions")
}

/// An institute's curriculum scope for the shared cross-repo taxonomy (Taxonomy
/// Service, own datasource -- see prisma/taxonomy/schema.prisma). Lives here, not
/// there, because this is institution data (who the institute is, what it teaches),
/// not classification data (what the tree looks like) -- Vidyaverse already owns
/// Institution identity, so this is the one source of truth rather than splitting
/// institution data across two services.
///
/// Stores resolved SUBJECT-level (or PAPER/SUBJECT_PAPER, per domain) taxonomy node
/// ids directly -- the onboarding/settings picker's Board->Medium->Class selection
/// expands to concrete leaf ids at save time, so a read at request time (every
/// scoped RAG search, in both PDLMS and DigiClassroom) is O(1), never a tree-walk.
/// taxonomyNodeId is intentionally NOT a foreign key -- it lives in a different
/// Postgres datasource, so referential integrity across them can't be enforced by
/// Postgres and isn't attempted here.
/// What a learner says they are studying (curriculum v2 nodes: a board's class, a programme, an exam), the same shape
/// as Book Buddy's UserLearningGoal. One goal is primary (a partial unique index in the migration). DigiClassroom and
/// PDLMS read and write it for federated learners through /api/v1/academic/my-learning-path.
model LearnerGoal {
  userId          String   @map("user_id") @db.VarChar(36)
  nodeId          String   @map("node_id") @db.VarChar(36)
  isPrimary       Boolean  @default(false) @map("is_primary")
  /// The stream for a Class 11-12 goal ("CBSE_SCI_PCM"); a plain code that survives taxonomy releases.
  combinationCode String?  @map("combination_code") @db.VarChar(60)
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId])
  @@map("learner_goals")
}

model InstitutionCurriculumScope {
  id             String      @id @default(uuid()) @db.VarChar(36)
  institutionId  String      @map("institution_id") @db.VarChar(36)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  taxonomyNodeId String      @map("taxonomy_node_id") @db.VarChar(36)
  createdAt      DateTime    @default(now()) @map("created_at")
  createdBy      String?     @map("created_by") @db.VarChar(36)

  @@unique([institutionId, taxonomyNodeId])
  @@index([institutionId])
  @@map("institution_curriculum_scopes")
}

model ChatConversation {
  id            String            @id @default(uuid()) @db.VarChar(36)
  institutionId String            @map("institution_id") @db.VarChar(36)
  type          ConversationType  @default(direct)
  name          String?           @db.VarChar(255)
  lastMessageAt DateTime?         @map("last_message_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  messages      ChatMessage[]
  participants  ChatParticipant[]

  @@map("chat_conversations")
}

model ChatParticipant {
  id             String           @id @default(uuid()) @db.VarChar(36)
  conversationId String           @map("conversation_id") @db.VarChar(36)
  userId         String           @map("user_id") @db.VarChar(36)
  isAdmin        Boolean          @default(false) @map("is_admin")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  lastReadAt     DateTime?        @map("last_read_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId], map: "chat_participants_user_id_idx")
  @@map("chat_participants")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.VarChar(36)
  conversationId String           @map("conversation_id") @db.VarChar(36)
  senderId       String           @map("sender_id") @db.VarChar(36)
  type           MessageType      @default(text)
  content        String           @db.Text
  metadata       Json?
  status         MessageStatus    @default(sent)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "chat_messages_conversation_id_idx")
  @@index([senderId], map: "chat_messages_sender_id_idx")
  @@map("chat_messages")
}

model CallSession {
  id              String    @id @default(uuid()) @db.VarChar(36)
  institutionId   String    @map("institution_id") @db.VarChar(36)
  conversationId  String?   @map("conversation_id") @db.VarChar(36)
  livekitRoomName String    @map("livekit_room_name") @db.VarChar(255)
  type            String    @default("video") @db.VarChar(20)
  hostId          String    @map("host_id") @db.VarChar(36)
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  participants    Json
  host            User      @relation("HostedCalls", fields: [hostId], references: [id])

  @@index([hostId], map: "call_sessions_host_id_idx")
  @@map("call_sessions")
}

model InstitutionAuthority {
  id            String                   @id @default(uuid()) @db.VarChar(36)
  institutionId String                   @map("institution_id") @db.VarChar(36)
  name          String                   @db.VarChar(255)
  designation   String                   @db.VarChar(255)
  roleType      InstitutionAuthorityRole @default(CUSTOM) @map("role_type")
  email         String?                  @db.VarChar(255)
  phone         String?                  @db.VarChar(20)
  signatureUrl  String?                  @map("signature_url") @db.VarChar(500)
  displayOrder  Int                      @default(0) @map("display_order")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  institution   Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([roleType])
  @@map("institution_authorities")
}

model Branch {
  id            String      @id @default(uuid()) @db.VarChar(36)
  institutionId String      @map("institution_id") @db.VarChar(36)
  name          String      @db.VarChar(255)
  code          String      @db.VarChar(50)
  address       String?     @db.Text
  contactEmail  String?     @map("contact_email") @db.VarChar(255)
  contactPhone  String?     @map("contact_phone") @db.VarChar(20)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classes       Class[]
  students      Student[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("branches")
}

model User {
  id                        String                  @id @default(uuid()) @db.VarChar(36)
  email                     String                  @unique @db.Citext
  passwordHash              String?                 @map("password_hash") @db.VarChar(255)
  name                      String                  @db.VarChar(255)
  phone                     String?                 @db.VarChar(20)
  emailVerified             Boolean                 @default(false) @map("email_verified")
  image                     String?                 @db.Text
  isActive                  Boolean                 @default(true) @map("is_active")
  isVerified                Boolean                 @default(false) @map("is_verified")
  emailVerificationToken    String?                 @map("email_verification_token") @db.VarChar(255)
  passwordResetToken        String?                 @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires      DateTime?               @map("password_reset_expires")
  twoFactorEnabled          Boolean                 @default(false) @map("two_factor_enabled")
  twoFactorSecret           String?                 @map("two_factor_secret") @db.VarChar(255)
  globalRole                GlobalRole?             @default(student) @map("global_role")
  lastLoginAt               DateTime?               @map("last_login_at")
  lastLoginIp               String?                 @map("last_login_ip") @db.VarChar(50)
  failedLoginAttempts       Int                     @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?               @map("locked_until")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  alternateEmails           Json?                   @map("alternate_emails")
  externalSubjects          Json?                   @map("external_subjects")
  /// The language a learner studies in (ISO 639-1: en, hi...), set at onboarding. Read by DigiClassroom and PDLMS.
  preferredMedium           String?                 @map("preferred_medium") @db.VarChar(8)
  /// "I'm just exploring": no learning goals, and do not ask again.
  learningPathSkippedAt     DateTime?               @map("learning_path_skipped_at")
  learnerGoals              LearnerGoal[]
  accounts                  Account[]
  approvalRequests          ApprovalRequest[]
  approvedSteps             ApprovalStep[]
  reviewedApprovals         Approval[]              @relation("ReviewedApprovals")
  submittedApprovals        Approval[]              @relation("SubmittedApprovals")
  markedAttendanceRecords   AttendanceRecord[]
  createdAttendanceSessions AttendanceSession[]
  auditLogs                 AuditLog[]
  hostedCalls               CallSession[]           @relation("HostedCalls")
  sentMessages              ChatMessage[]           @relation("SentMessages")
  chatParticipations        ChatParticipant[]
  notifications             Notification[]
  oauthAccessTokens         OauthAccessToken[]
  oauthApplications         OauthApplication[]
  oauthConsents             OauthConsent[]
  classTeacherSections      Section[]               @relation("SectionClassTeacher")
  sessions                  Session[]
  socialComments            SocialComment[]         @relation("UserComments")
  socialPosts               SocialPost[]            @relation("UserPosts")
  socialReactions           SocialReaction[]        @relation("UserReactions")
  relationshipsFrom         SocialRelationship[]    @relation("RelationshipsFrom")
  relationshipsTo           SocialRelationship[]    @relation("RelationshipsTo")
  saathiSent                SocialSaathiLink[]      @relation("SaathiSent")
  saathiReceived            SocialSaathiLink[]      @relation("SaathiReceived")
  student                   Student?
  institutionRoles          UserInstitutionRole[]
  authoredArticles          VisionariumArticle[]    @relation("UserArticles")
  visionariumSubmissions    VisionariumSubmission[] @relation("UserSubmissions")
  visitingCards             VisitingCard[]

  @@index([email])
  @@index([passwordResetToken])
  @@map("users")
}

model AdminInvitation {
  id            String           @id @default(uuid()) @db.VarChar(36)
  institutionId String           @map("institution_id") @db.VarChar(36)
  email         String           @db.Citext
  token         String           @unique @db.VarChar(255)
  expiresAt     DateTime         @map("expires_at")
  status        InvitationStatus @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([institutionId])
  @@map("admin_invitations")
}

model UserInstitutionRole {
  id                   String          @id @default(uuid()) @db.VarChar(36)
  userId               String          @map("user_id") @db.VarChar(36)
  institutionId        String          @map("institution_id") @db.VarChar(36)
  role                 InstitutionRole
  assignedClasses      Json?           @map("assigned_classes")
  assignedSections     Json?           @map("assigned_sections")
  studentAccessEnabled Boolean         @default(false) @map("student_access_enabled")
  studentAccessExpires DateTime?       @map("student_access_expires")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  institution          Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([role])
  @@index([institutionId])
  @@map("user_institution_roles")
}

model Class {
  id                    String                  @id @default(uuid()) @db.VarChar(36)
  institutionId         String                  @map("institution_id") @db.VarChar(36)
  branchId              String?                 @map("branch_id") @db.VarChar(36)
  name                  String                  @db.VarChar(100)
  displayOrder          Int                     @default(0) @map("display_order")
  streamsEnabled        Boolean                 @default(false) @map("streams_enabled")
  /// The curriculum v2 node this class teaches (a board's class, a programme, an exam course). Its students inherit
  /// it as their main learning goal. A plain uuid: the taxonomy lives in the trio database.
  curriculumNodeId      String?                 @map("curriculum_node_id") @db.VarChar(36)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  attendanceSessions    AttendanceSession[]
  branch                Branch?                 @relation(fields: [branchId], references: [id])
  institution           Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  groupPhotos           GroupPhoto[]
  sections              Section[]
  socialPosts           SocialPost[]
  streams               Stream[]
  subjects              Subject[]
  visionariumTestSeries VisionariumTestSeries[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([branchId])
  @@map("classes")
}

model Stream {
  id            String      @id @default(uuid()) @db.VarChar(36)
  institutionId String      @map("institution_id") @db.VarChar(36)
  classId       String      @map("class_id") @db.VarChar(36)
  name          String      @db.VarChar(100)
  description   String?     @db.Text
  displayOrder  Int         @default(0) @map("display_order")
  /// The curriculum v2 stream this is ("CBSE_SCI_PCM"), for the class's node. Students in its sections inherit it.
  combinationCode String?   @map("combination_code") @db.VarChar(60)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  sections      Section[]
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@index([institutionId], map: "streams_institution_id_idx")
  @@map("streams")
}

model Section {
  id                   String              @id @default(uuid()) @db.VarChar(36)
  institutionId        String              @map("institution_id") @db.VarChar(36)
  classId              String              @map("class_id") @db.VarChar(36)
  streamId             String?             @map("stream_id") @db.VarChar(36)
  name                 String              @db.VarChar(50)
  expectedStudentCount Int                 @default(0) @map("expected_student_count")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  classTeacherId       String?             @map("class_teacher_id") @db.VarChar(36)
  admissionSlots       AdmissionSlot[]
  attendanceSessions   AttendanceSession[]
  groupPhotos          GroupPhoto[]
  class                Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher         User?               @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  institution          Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  stream               Stream?             @relation(fields: [streamId], references: [id])
  socialPosts          SocialPost[]
  students             Student[]

  @@unique([classId, streamId, name])
  @@index([classTeacherId], map: "sections_class_teacher_id_idx")
  @@index([institutionId], map: "sections_institution_id_idx")
  @@index([streamId], map: "sections_stream_id_idx")
  @@map("sections")
}

model AdmissionSlot {
  id             String     @id @default(cuid()) @db.Char(30)
  sectionId      String     @map("section_id") @db.VarChar(36)
  rollNo         Int        @map("roll_no")
  status         SlotStatus @default(EMPTY)
  token          String     @unique @default(cuid()) @db.VarChar(50)
  tokenExpiresAt DateTime?  @map("token_expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  section        Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student        Student?

  @@unique([sectionId, rollNo])
  @@index([sectionId])
  @@index([status])
  @@index([token])
  @@map("admission_slots")
}

model Student {
  id                      String                   @id @default(uuid()) @db.VarChar(36)
  institutionId           String                   @map("institution_id") @db.VarChar(36)
  sectionId               String                   @map("section_id") @db.VarChar(36)
  branchId                String?                  @map("branch_id") @db.VarChar(36)
  slotId                  String?                  @unique @map("slot_id") @db.Char(30)
  admissionNumber         String?                  @unique @map("admission_number") @db.VarChar(50)
  name                    String                   @db.VarChar(255)
  academicYear            String                   @default("2025-2026") @map("academic_year") @db.VarChar(20)
  fatherName              String?                  @map("father_name") @db.VarChar(255)
  motherName              String?                  @map("mother_name") @db.VarChar(255)
  guardianName            String?                  @map("guardian_name") @db.VarChar(255)
  guardianRelation        String?                  @map("guardian_relation") @db.VarChar(50)
  guardianPhone           String?                  @map("guardian_phone") @db.VarChar(20)
  sex                     Sex?
  dob                     DateTime?                @db.Date
  bloodGroup              String?                  @map("blood_group") @db.VarChar(10)
  aadharNumber            String?                  @map("aadhar_number") @db.VarChar(12)
  caste                   String?                  @db.VarChar(100)
  religion                String?                  @db.VarChar(100)
  contact                 String?                  @db.VarChar(20)
  parentEmail             String?                  @map("parent_email") @db.Citext
  address                 String?                  @db.Text
  city                    String?                  @db.VarChar(100)
  state                   String?                  @db.VarChar(100)
  pincode                 String?                  @db.VarChar(10)
  dateOfAdmission         DateTime?                @map("date_of_admission") @db.Date
  previousSchool          String?                  @map("previous_school") @db.Text
  transportMode           String?                  @map("transport_mode") @db.VarChar(50)
  photoUrl                String?                  @map("photo_url") @db.VarChar(500)
  photoHash               String?                  @map("photo_hash") @db.VarChar(64)
  studentSignatureUrl     String?                  @map("student_signature_url") @db.VarChar(500)
  parentSignatureUrl      String?                  @map("parent_signature_url") @db.VarChar(500)
  medicalNotes            String?                  @map("medical_notes") @db.Text
  status                  StudentStatus            @default(active)
  dataStatus              DataStatus               @default(filled) @map("data_status")
  consentGiven            Boolean                  @default(false) @map("consent_given")
  consentTimestamp        DateTime?                @map("consent_timestamp")
  consentGivenBy          String?                  @map("consent_given_by") @db.VarChar(255)
