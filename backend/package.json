{
    "name": "@vidyaverse/backend",
    "version": "1.0.0",
    "description": "Vidyaverse Pro Backend API",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:unit": "vitest run --config vitest.config.unit.ts",
        "test:integration": "vitest run --config vitest.config.integration.ts",
        "test:coverage": "vitest run --coverage",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "smoke:oidc": "tsx src/scripts/smoke-oidc.ts",
        "smoke:operations": "tsx src/scripts/smoke-operations.ts",
        "smoke:academics": "tsx src/scripts/smoke-academics.ts",
        "smoke:insights": "tsx src/scripts/smoke-insights.ts",
        "smoke:extensions": "tsx src/scripts/smoke-extensions.ts",
        "smoke:online-tests": "tsx src/scripts/smoke-online-tests.ts",
        "smoke:r2": "tsx src/scripts/smoke-r2.ts",
        "smoke:printables": "tsx src/scripts/smoke-printables.ts",
        "seed:academics": "tsx prisma/seed-academics.ts",
        "test:live": "tsx src/scripts/live-http-test.ts",
        "test:fed:setup": "tsx src/scripts/fed-test-setup.ts",
        "test:fed:flow": "tsx src/scripts/fed-test-flow.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1038.0",
        "@aws-sdk/s3-request-presigner": "^3.1038.0",
        "@fastify/cookie": "^9.3.1",
        "@fastify/cors": "^9.0.1",
        "@fastify/csrf-protection": "^6.4.1",
        "@fastify/helmet": "^11.1.1",
        "@fastify/multipart": "^8.1.0",
        "@fastify/rate-limit": "^9.1.0",
        "@fastify/swagger": "^8.14.0",
        "@fastify/swagger-ui": "^3.0.0",
        "@fastify/websocket": "^11.3.0",
        "@prisma/client": "^5.10.0",
        "@sentry/node": "^10.69.0",
        "@types/nodemailer": "^7.0.9",
        "@vidyaverse/shared-validation": "workspace:*",
        "adm-zip": "^0.5.17",
        "bcryptjs": "^3.0.2",
        "better-auth": "^1.4.20",
        "bullmq": "^5.4.0",
        "date-fns": "^3.3.1",
        "dompurify": "^3.3.3",
        "dotenv": "^16.4.5",
        "fast-csv": "^5.0.5",
        "fastify": "^4.26.2",
        "fastify-plugin": "^4.5.1",
        "handlebars": "^4.7.8",
        "ioredis": "^5.3.2",
        "jsdom": "^28.1.0",
        "livekit-server-sdk": "^2.15.5",
        "nanoid": "^5.1.6",
        "nodemailer": "^8.0.1",
        "pdf-lib": "^1.17.1",
        "pino": "^8.19.0",
        "pino-pretty": "^10.3.1",
        "puppeteer": "^22.4.0",
        "qrcode": "^1.5.3",
        "sharp": "^0.33.2",
        "speakeasy": "^2.0.0",
        "swagger-ui-dist": "^5.31.1",
        "uuid": "^11.1.0",
        "ws": "^8.18.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/bcryptjs": "^3.0.0",
        "@types/dompurify": "^3.2.0",
        "@types/jsdom": "^28.0.1",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.11.24",
        "@types/qrcode": "^1.5.5",
        "@types/supertest": "^7.2.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^7.1.1",
        "@typescript-eslint/parser": "^7.1.1",
        "eslint": "^8.57.0",
        "jsonwebtoken": "^9.0.3",
        "prisma": "^5.10.0",
        "supertest": "^7.2.2",
        "tsx": "^4.7.1",
        "typescript": "^5.3.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^1.3.1"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}